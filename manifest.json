{
  "id": "attendance",
  "name": "Attendance",
  "version": "1.1.1",
  "description": "Meeting and practice attendance for clubs and troops \u2014 take the roll in seconds, see who's been showing up, and spot members who are drifting away.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": [
    "attendance",
    "club",
    "meetings",
    "roll-call",
    "members"
  ],
  "contexts": [
    "household",
    "shared_space",
    "shared_space.roster"
  ],
  "icon": "\u2705",
  "data_access": {
    "reads": [
      "family.members"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "events": {"sql": "SELECT id, title, kind, event_date, start_time, location, notes, series_id, created_by, created_at FROM app_attendance__events ORDER BY event_date DESC LIMIT 300"},
    "records": {"sql": "SELECT id, event_id, member_id, status, note, recorded_by, created_at FROM app_attendance__records LIMIT 3000"},
    "series": {"sql": "SELECT id, title, kind, weekday, interval_weeks, start_time, location, notes, start_date, end_date, active, created_by, created_at FROM app_attendance__series ORDER BY created_at DESC LIMIT 100"}
  },
  "db_plaintext_columns": [
    "event_date",
    "start_time"
  ],
  "automation_actions": {
    "add_session": {
      "title": "Schedule an attendance session",
      "description": "Create a session to take roll at when another app's event fires - a calendar event, a trip, a volunteer shift. The date comes from the trigger payload.",
      "params": {
        "created_by": { "type": "member", "label": "Scheduled by", "required": true },
        "title": { "type": "text", "label": "Session name", "required": true },
        "event_date": { "type": "text", "label": "Date (YYYY-MM-DD)", "required": true },
        "kind": {
          "type": "text",
          "label": "Kind",
          "default": "meeting",
          "options": ["meeting", "practice", "service", "other"]
        },
        "start_time": { "type": "text", "label": "Start time (HH:MM)", "default": "" },
        "location": { "type": "text", "label": "Where", "default": "" }
      },
      "dedupe": { "table": "events", "column": "source_event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "events",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "kind": ":kind",
            "event_date": ":event_date",
            "start_time": ":start_time",
            "location": ":location",
            "created_by": ":created_by",
            "created_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "row_policies": {
    "events": {
      "kind": "adult_writable",
      "steward_writes_only": true
    },
    "records": {
      "kind": "adult_writable",
      "steward_writes_only": true,
      "member_read_column": "member_id"
    },
    "series": {
      "kind": "adult_writable",
      "steward_writes_only": true
    }
  },
  "publishes": [
    "attendance.session_created"
  ],
  "publish_acls": {
    "attendance.session_created": { "require_role": "adult" }
  },
  "agenda": {
    "kind": "event",
    "label": "Attendance",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, title AS title, CASE WHEN start_time <> '' THEN (event_date || 'T' || start_time) ELSE event_date END AS when_at, NULLIF(location, '') AS subtitle FROM app_attendance__events WHERE event_date = :today ORDER BY start_time LIMIT 10"
    }
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS value FROM app_attendance__events WHERE event_date >= :today AND event_date <= date(:today, '+6 days') LIMIT 1"
    },
    "display": {
      "template": "stat",
      "value": "value",
      "label": "sessions this week",
      "empty_hides": true
    }
  },
  "member_references": {
    "events": { "column": "created_by", "on_removed": "keep" },
    "series": { "column": "created_by", "on_removed": "keep" },
    "records": [
      { "column": "member_id", "on_removed": "delete" },
      { "column": "recorded_by", "on_removed": "keep" }
    ]
  },
  "nav": {
    "label": "Attendance"
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": [
      "events",
      "records"
    ]
  }
}
